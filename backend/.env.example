# Google service account: paste JSON, or a path to the JSON key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to the above when using a key file path.
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# Spreadsheet and Drive folder that have been shared with the service account.
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Optional A1 range for appends (first sheet, columns A–F by default).
# GOOGLE_SHEET_RANGE=A:F
